# Copy to .env and fill in.
# Diwan is OpenAI-compatible; point Lobster Trap upstream at any provider.

# Upstream LLM (Lobster Trap proxies to this)
# Examples:
#   OpenAI:    https://api.openai.com/v1
#   Anthropic: https://api.anthropic.com/v1   (with Claude-compatible client)
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/   (OpenAI-compat endpoint)
#   Ollama:    http://host.docker.internal:11434/v1
LOBSTERTRAP_UPSTREAM=https://generativelanguage.googleapis.com/v1beta/openai/

# Provider API key (forwarded by Lobster Trap to upstream)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gemini model used by ui service for trajectory classification
GEMINI_MODEL=gemini-3.1-pro
